# mcak 配置（mcak dev / release / doctor 读取；也可被 shell source）
APP_NAME=Snapcut
SCHEME=Snapcut
BUNDLE_ID=app.snapcut.snapcut
BUNDLE_PATH=build/Snapcut.app

# 固定开发签名证书：TCC 授权锚定的就是这张证书的 leaf hash。
# 换证书 = 系统视作另一个 App = 屏幕录制/辅助功能要重授一次。
DEV_SIGN_CN="Snapcut Local Dev"

# postsign：xcodebuild 出 ad-hoc 包，之后用上面这张证书重签（自签、无需开发者账号）
SIGN_MODE=postsign

# 发版仓库（与 project.yml 的 SUFeedURL 一致）
REPO=cheney12138/snapcut
